
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blogify | Home</title>

    <%- include('partials/script') %>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #1e293b;
            line-height: 1.6;
        }

        .hero {
            text-align: center;
            padding: 55px 20px 40px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
        }

        .hero h1 {
            font-size: clamp(2rem, 4vw, 2.8rem);
            margin-bottom: 10px;
            letter-spacing: -1px;
        }

        .hero p {
            color: #64748b;
            font-size: 1.05rem;
        }

        .hero-line {
            width: 55px;
            height: 4px;
            background: #3b82f6;
            border-radius: 5px;
            margin: 20px auto 0;
        }

        .blogs-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 24px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 24px;
        }

        .section-heading h2 {
            font-size: 1.5rem;
        }

        .blog-count {
            color: #64748b;
            font-size: 0.9rem;
        }

        .blogs-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
        }

        .blog-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .blog-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.09);
        }

        .blog-image {
            width: 100%;
            height: 210px;
            object-fit: cover;
            display: block;
            background: #e2e8f0;
        }

        .image-placeholder {
            height: 180px;
            display: grid;
            place-items: center;
            background: #eaf0fa;
            color: #64748b;
            font-size: 0.9rem;
        }

        .blog-content {
            padding: 20px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .blog-content h3 {
            font-size: 1.2rem;
            line-height: 1.4;
            margin-bottom: 10px;
            overflow-wrap: anywhere;
        }

        .blog-excerpt {
            color: #64748b;
            font-size: 0.95rem;
            margin-bottom: 20px;
            overflow-wrap: anywhere;

            /* Show a maximum of 3 lines */
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .blog-footer {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid #f1f5f9;
        }

        .read-more {
            display: inline-block;
            background: #2563eb;
            color: #ffffff;
            text-decoration: none;
            padding: 9px 15px;
            border-radius: 7px;
            font-size: 0.9rem;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        .read-more:hover {
            background: #1d4ed8;
        }

        .empty-state {
            text-align: center;
            background: #ffffff;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
            padding: 55px 20px;
        }

        .empty-state h3 {
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #64748b;
            margin-bottom: 20px;
        }

        .create-button {
            display: inline-block;
            background: #2563eb;
            color: #ffffff;
            padding: 11px 20px;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
        }

        .create-button:hover {
            background: #1d4ed8;
        }

        @media (max-width: 900px) {
            .blogs-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 600px) {
            .blogs-container {
                margin: 28px auto;
                padding: 0 16px;
            }

            .blogs-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .hero {
                padding: 38px 16px 30px;
            }

            .blog-image {
                height: 220px;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <header class="hero">
        <h1>Latest Blogs</h1>
        <p>Discover stories, ideas and thoughts from our community.</p>
        <div class="hero-line"></div>
    </header>

    <main class="blogs-container">

        <div class="section-heading">
            <h2>Explore articles</h2>

            <% if (Blogs) { %>
                <span class="blog-count">
                    <%= Blogs.length %> articles
                </span>
            <% } %>
        </div>

        <% if (Blogs && Blogs.length > 0) { %>

            <div class="blogs-grid">

                <% Blogs.forEach((blog) => { %>

                    <article class="blog-card">

                        <% if (blog.coverImageURL) { %>
                            <img
                                src="<%= blog.coverImageURL %>"
                                alt="<%= blog.title %>"
                                class="blog-image"
                                loading="lazy"
                            >
                        <% } else { %>
                            <div class="image-placeholder">
                                No cover image
                            </div>
                        <% } %>

                        <div class="blog-content">

                            <h3><%= blog.title %></h3>

                            <p class="blog-excerpt">
                                <%= blog.body %>
                            </p>

                            <div class="blog-footer">
                                <a
                                    href="/blog/<%= blog._id %>"
                                    class="read-more"
                                >
                                    Read more &rarr;
                                </a>
                            </div>

                        </div>
                    </article>

                <% }) %>

            </div>

        <% } else { %>

            <section class="empty-state">
                <h3>No blogs published yet</h3>
                <p>Be the first to share something interesting.</p>

                <a href="/blog" class="create-button">
                    Create a blog
                </a>
            </section>

        <% } %>

    </main>

</body>
</html>
